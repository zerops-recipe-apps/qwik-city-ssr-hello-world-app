{
  "name": "qwik-city-ssr-hello-world-app",
  "version": "1.0.0",
  "description": "Minimal Qwik City SSR demo for Zerops with PostgreSQL (Express, Node.js runtime).",
  "author": "Zerops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerops-recipe-apps/qwik-city-ssr-hello-world-app.git"
  },
  "homepage": "https://github.com/zerops-recipe-apps/qwik-city-ssr-hello-world-app",
  "bugs": {
    "url": "https://github.com/zerops-recipe-apps/qwik-city-ssr-hello-world-app/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build.client && npm run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/express/vite.config.ts",
    "dev": "vite --mode ssr",
    "preview": "node server/entry.express"
  },
  "dependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "express": "5.2.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "26.1.2",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "sharp": "0.35.3",
    "vite": "6.4.3"
  },
  "keywords": [
    "qwik",
    "qwik-city",
    "express",
    "zerops",
    "ssr",
    "nodejs",
    "postgresql",
    "hello-world"
  ]
}
